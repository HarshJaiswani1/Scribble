# Port the realtime server listens on.
PORT=4500

# Comma-separated browser origins allowed to connect. REQUIRED in production —
# when NODE_ENV=production and this is unset, every browser origin is refused.
# In development any localhost port is accepted and this can stay empty.
WEB_ORIGIN=http://localhost:3400

# Round timings (ms). Defaults live in packages/shared/src/constants.ts.
# WORD_SELECT_MS=15000
# ROUND_END_MS=6000
# GAME_END_MS=20000
# Overrides the room's own draw-time setting entirely.
# DRAW_TIME_MS=80000

# Room lifecycle timings (ms). These overrides exist for tuning, and for
# compressing timings in the integration tests.
# RECONNECT_GRACE_MS=30000
# EMPTY_ROOM_TTL_MS=60000
# SWEEP_INTERVAL_MS=15000
